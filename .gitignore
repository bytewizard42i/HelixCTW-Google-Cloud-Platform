# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.lock.hcl

# GCP credentials — NEVER commit
*-service-account*.json
*credentials*.json
gcp-key*.json
application_default_credentials.json

# Env / secrets
.env
.env.*
*.seed

# OS / editor
.DS_Store
*.swp

# Node (if any tooling lands here)
node_modules/
web/dist/
.env.local

# Rendered videos — large binaries stay out of Git (sources are committed)
media/videos/

# Windows Mark-of-the-Web
*:Zone.Identifier
